{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Resolve `lexical` / `@lexical/*` to their TypeScript source via the
       `source` export condition, matching app/vite.config.ts so tsc and the
       bundler agree. Without it tsc falls through to dist/*.d.ts, which the
       source-mode workflow never builds. */
    "customConditions": ["source"],

    /* strict, but without the unused-locals lints: the program now includes
       lexical's own source, whose internal signatures intentionally keep
       unused params. */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{"path": "./tsconfig.node.json"}]
}
