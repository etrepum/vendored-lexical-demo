{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Resolve `lexical` / `@lexical/*` to their TypeScript source via the
       `source` export condition, exactly like app/vite.config.ts. Without this,
       tsc AND the editor's language server fall through to dist/*.d.ts (never
       built in source mode) and report "Cannot find module 'lexical'". Needs
       TypeScript >= 5.0 — see .vscode/settings.json for the editor. */
    "customConditions": ["source"],

    /* strict, minus the unused-locals lints: the program now includes lexical's
       own source, whose internal signatures intentionally keep unused params. */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
